# Defaults for ./scripts/local.sh (you can override them when asked; Enter = value from here).
# Environment variables take precedence over this file.
IDRAC_HOST=idrac.example.lan
IDRAC_HTTPS_PORT=443
IDRAC_KVM_PORT=5900
IDRAC_USER=root

# Folder with ISO images on your computer (mounted at /iso, read-only). Default: ./iso
# ISO_DIR=~/Downloads

# Debian mirror for building the image. If unset, scripts/local.sh benchmarks mirrors and remembers
# the fastest in .mirror
# DEB_MIRROR=mirror.yandex.ru

# Better not to store the password here: the container asks for it at start-up.
# IDRAC_PASSWORD=
